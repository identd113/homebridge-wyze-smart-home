{
  "name": "homebridge-wyze-smart-home",
  "version": "2.0.0-beta.3",
  "description": "Wyze Smart Home plugin for Homebridge",
  "license": "MIT",
  "main": "src/index.js",
  "homebridge": {
    "pluginAlias": "WyzeSmartHome",
    "platform": "WyzeSmartHome"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint src/**.js --max-warnings=0",
    "start": "hb-service run -P ../ -U ./ --stdout",
    "dev-link": "npm link ../wyze-api",
    "known-models": "node .github/scripts/gen-known-models.js"
  },
  "keywords": [
    "homebridge-plugin",
    "Wyze",
    "Hoobs"
  ],
  "homepage": "http://github.com/identd113/homebridge-wyze-smart-home",
  "repository": {
    "type": "git",
    "url": "git://github.com/identd113/homebridge-wyze-smart-home.git"
  },
  "bugs": {
    "url": "http://github.com/identd113/homebridge-wyze-smart-home/issues"
  },
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0",
    "node": "^22.0.0 || ^24 || ^26"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "ffmpeg-static": "^5.3.0",
    "querystring": "0.2.1",
    "semver": "^7.6.0",
    "utf8": "^3.0.0",
    "uuid-by-string": "4.0.0",
    "werift": "^0.25.1",
    "wyze-api": "^2.0.0-beta.4"
  },
  "devDependencies": {
    "@fastify/multipart": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "homebridge": "^2.0.0",
    "homebridge-config-ui-x": "^5.22.0"
  }
}
