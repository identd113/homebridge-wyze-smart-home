{
  "name": "homebridge-wyze-smart-home",
  "version": "2.0.0-beta.4",
  "description": "Wyze Smart Home plugin for Homebridge",
  "license": "MIT",
  "main": "src/index.js",
  "homebridge": {
    "pluginAlias": "WyzeSmartHome",
    "platform": "WyzeSmartHome"
  },
  "files": [
    "src",
    "homebridge-ui",
    "config.schema.json",
    "configSample.json",
    "logo.png",
    "license.txt",
    "CONTRIBUTORS.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint src --max-warnings=0",
    "start": "hb-service run -P ../ -U ./ --stdout",
    "dev-link": "npm link ../wyze-api",
    "known-models": "node .github/scripts/gen-known-models.js",
    "device-options": "node .github/scripts/gen-device-options.js"
  },
  "keywords": [
    "homebridge-plugin",
    "Wyze",
    "Hoobs"
  ],
  "homepage": "http://github.com/identd113/homebridge-wyze-smart-home",
  "repository": {
    "type": "git",
    "url": "git://github.com/identd113/homebridge-wyze-smart-home.git"
  },
  "bugs": {
    "url": "http://github.com/identd113/homebridge-wyze-smart-home/issues"
  },
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0",
    "node": "^22.0.0 || ^24 || ^26"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "axios": "^1.15.0",
    "semver": "^7.6.0",
    "wyze-api": "^2.0.0-beta.4"
  },
  "devDependencies": {
    "@fastify/multipart": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "homebridge": "^2.0.0",
    "homebridge-config-ui-x": "^5.22.0"
  }
}
